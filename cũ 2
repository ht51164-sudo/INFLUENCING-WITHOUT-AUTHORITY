function buildRadar(scores){
  const canvas = document.getElementById('radar');
  const ctx = canvas.getContext('2d');
  const W=canvas.width, H=canvas.height, cx=W/2, cy=H/2;
  const R = Math.min(W,H)/2 - 58;
  const N=6, maxVal=10;
  const angle = i => (-Math.PI/2)+(i/N)*2*Math.PI;

  ctx.clearRect(0,0,W,H);

  // Grid rings
  for(let ring=1;ring<=5;ring++){
    const r=R*(ring/5);
    ctx.beginPath();
    for(let i=0;i<N;i++){
      const x=cx+r*Math.cos(angle(i)), y=cy+r*Math.sin(angle(i));
      i===0?ctx.moveTo(x,y):ctx.lineTo(x,y);
    }
    ctx.closePath();
    ctx.strokeStyle='rgba(255,255,255,0.07)'; ctx.lineWidth=1; ctx.stroke();
    ctx.fillStyle='rgba(255,255,255,0.18)'; ctx.font='10px Be Vietnam Pro';
    ctx.textAlign='center'; ctx.textBaseline='middle';
    ctx.fillText(ring*2, cx+4, cy-r+1);
  }

  // Axis lines
  for(let i=0;i<N;i++){
    ctx.beginPath(); ctx.moveTo(cx,cy);
    ctx.lineTo(cx+R*Math.cos(angle(i)), cy+R*Math.sin(angle(i)));
    ctx.strokeStyle='rgba(255,255,255,0.1)'; ctx.lineWidth=1; ctx.stroke();
  }

  // Data polygon
  ctx.beginPath();
  scores.forEach((s,i)=>{
    const r=R*(s/maxVal), x=cx+r*Math.cos(angle(i)), y=cy+r*Math.sin(angle(i));
    i===0?ctx.moveTo(x,y):ctx.lineTo(x,y);
  });
  ctx.closePath();
  ctx.fillStyle='rgba(245,158,11,0.15)'; ctx.fill();
  ctx.strokeStyle='rgba(245,158,11,0.75)'; ctx.lineWidth=2.5; ctx.stroke();

  // Dots
  scores.forEach((s,i)=>{
    const r=R*(s/maxVal), x=cx+r*Math.cos(angle(i)), y=cy+r*Math.sin(angle(i));
    ctx.beginPath(); ctx.arc(x,y,5,0,Math.PI*2);
    ctx.fillStyle=axes[i].color; ctx.fill();
  });

  // Labels
  scores.forEach((s,i)=>{
    const off=R+32, x=cx+off*Math.cos(angle(i)), y=cy+off*Math.sin(angle(i));
    ctx.fillStyle=axes[i].color; ctx.font='bold 12px Be Vietnam Pro';
    ctx.textAlign='center'; ctx.textBaseline='middle';
    const words=axes[i].name.split(' ');
    words.forEach((w,wi)=>ctx.fillText(w, x, y+(wi-(words.length-1)/2)*15));
  });
}

