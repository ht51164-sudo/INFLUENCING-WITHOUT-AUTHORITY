function buildSituations(){
  const container = document.getElementById('situations');
  const letters = ['A','B','C','D','E','F'];
  situations.forEach((s,si)=>{
    const card = document.createElement('div');
    card.className = 'sit-card';
    let optsHtml = s.opts.map((o,oi)=>`
      <label class="option">
        <input type="radio" name="s${si}" value="${oi}">
        <div class="opt-letter">${letters[oi]}</div>
        <div class="opt-text">${o}</div>
      </label>`).join('');
    card.innerHTML = `<div class="sit-num">${s.num}</div><div class="sit-q">${s.q}</div><div class="options">${optsHtml}</div>`;
    container.appendChild(card);
    card.querySelectorAll('.option').forEach(opt=>{
      opt.querySelector('input').addEventListener('change',()=>{
        card.querySelectorAll('.option').forEach(x=>x.classList.remove('selected'));
        opt.classList.add('selected');
        updateProgress();
      });
    });
