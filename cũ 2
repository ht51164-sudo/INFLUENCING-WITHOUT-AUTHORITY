function buildLikert(){
  const container = document.getElementById('likert-rows');
  likertQs.forEach((q,qi)=>{
    const row = document.createElement('div');
    row.className = 'likert-row';
    let cells = '';
    for(let v=1;v<=5;v++){
      cells += `<div class="q-cell"><input type="radio" name="q${qi}" id="q${qi}v${v}" value="${v}"><label for="q${qi}v${v}">${v}</label></div>`;
    }
    row.innerHTML = `<div class="q-text"><span class="q-num">${qi+1}.</span>${q.text}</div>${cells}`;
    row.querySelectorAll('input').forEach(inp=>inp.addEventListener('change', updateProgress));
    container.appendChild(row);
  });
}

function updateProgress(){
  let done = 0;
  for(let i=0;i<5;i++) if(document.querySelector(`input[name="s${i}"]:checked`)) done++;
  for(let i=0;i<21;i++) if(document.querySelector(`input[name="q${i}"]:checked`)) done++;
  const total = 26;
  document.getElementById('prog-text').textContent = `${done} / ${total} câu`;
  document.getElementById('prog-bar').style.width = (done/total*100)+'%';
}

// ═══════════════════════════════════════════
// SCORING
// Each axis scored 0–10:
//   - Situations contribute up to 2 pts (binary: hit any = 2, else 0)
//   - Likert (3 questions per axis, max 15) normalized to 0–8
//   - Total max = 10
// ═══════════════════════════════════════════
function calcScores(){
  // Situation score: 2 if user picked the matching axis option, else 0 (capped at 2 per axis)
  const sitScore = [0,0,0,0,0,0];
  for(let si=0;si<5;si++){
    const inp = document.querySelector(`input[name="s${si}"]:checked`);
    if(!inp) continue;
    const ax = sitAxis[si][parseInt(inp.value)];
    sitScore[ax] = 2; // flat 2pts regardless of how many situations hit same axis
  }

  // Likert score per axis: sum of 3 questions (max 15) → normalize to 0–8
  const likertSum = [0,0,0,0,0,0];
  for(let qi=0;qi<21;qi++){
    const inp = document.querySelector(`input[name="q${qi}"]:checked`);
    if(!inp) continue;
    likertSum[likertQs[qi].ax] += parseInt(inp.value);
  }

  return axes.map((_,i)=>{
    const lNorm = (likertSum[i] / 15) * 8; // 3 questions × 5 max = 15
    return Math.round(Math.min(10, sitScore[i] + lNorm) * 10) / 10;
  });
}

