<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Bánh Xe Nguồn Lực Ảnh Hưởng</title>
<link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@300;400;500;600;700;800&family=Playfair+Display:wght@700&display=swap" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<style>
  :root {
    --bg: #0a0f1e;
    --bg2: #111827;
    --card: #161d2e;
    --border: #1e2d4a;
    --accent: #f59e0b;
    --accent2: #06b6d4;
    --accent3: #8b5cf6;
    --text: #e2e8f0;
    --text2: #94a3b8;
    --green: #10b981;
    --red: #ef4444;
    --r0: #f59e0b;
    --r1: #06b6d4;
    --r2: #8b5cf6;
    --r3: #10b981;
    --r4: #f43f5e;
    --r5: #fb923c;
  }
  * { margin:0; padding:0; box-sizing:border-box; }
  body {
    font-family: 'Be Vietnam Pro', sans-serif;
    background: var(--bg);
    color: var(--text);
    min-height: 100vh;
    overflow-x: hidden;
  }
  body::before {
    content:'';
    position:fixed; inset:0;
    background:
      radial-gradient(ellipse 80% 50% at 20% 10%, rgba(245,158,11,0.07) 0%, transparent 60%),
      radial-gradient(ellipse 60% 40% at 80% 80%, rgba(6,182,212,0.07) 0%, transparent 60%);
    pointer-events:none; z-index:0;
  }
  .wrap { max-width: 820px; margin: 0 auto; padding: 0 20px; position:relative; z-index:1; }

  header { text-align:center; padding: 60px 20px 40px; }
  .tag {
    display: inline-block;
    background: linear-gradient(90deg, var(--accent), var(--accent2));
    -webkit-background-clip: text; -webkit-text-fill-color: transparent;
    font-size: 12px; font-weight: 700; letter-spacing: 3px;
    text-transform: uppercase; margin-bottom: 16px;
  }
  header h1 {
    font-family: 'Playfair Display', serif;
    font-size: clamp(28px, 5vw, 46px); line-height: 1.2; margin-bottom: 16px;
    background: linear-gradient(135deg, #fff 0%, var(--accent) 100%);
    -webkit-background-clip: text; -webkit-text-fill-color: transparent;
  }
  header p { color: var(--text2); font-size: 15px; line-height: 1.7; max-width: 580px; margin: 0 auto 32px; }

  .progress-label { display:flex; justify-content:space-between; font-size:12px; color:var(--text2); margin-bottom:8px; }
  .progress-bar-wrap { background:var(--border); border-radius:99px; height:4px; margin-bottom:40px; overflow:hidden; }
  .progress-bar { height:100%; background:linear-gradient(90deg,var(--accent),var(--accent2)); border-radius:99px; transition:width 0.4s ease; width:0%; }

  .section-title { font-size:13px; font-weight:700; letter-spacing:2px; text-transform:uppercase; color:var(--accent); margin-bottom:6px; }
  .section-heading { font-size:20px; font-weight:700; margin-bottom:8px; }
  .section-desc { color:var(--text2); font-size:14px; line-height:1.6; margin-bottom:28px; }

  .sit-card { background:var(--card); border:1px solid var(--border); border-radius:16px; padding:28px; margin-bottom:24px; transition:border-color 0.2s; }
  .sit-card:hover { border-color:rgba(245,158,11,0.3); }
  .sit-num { font-size:11px; font-weight:700; letter-spacing:2px; text-transform:uppercase; color:var(--accent2); margin-bottom:10px; }
  .sit-q { font-size:15px; font-weight:600; line-height:1.6; margin-bottom:20px; }
  .options { display:flex; flex-direction:column; gap:10px; }
  .option {
    display:flex; align-items:flex-start; gap:12px; cursor:pointer;
    padding:12px 14px; border-radius:10px; border:1px solid transparent;
    transition:all 0.15s; background:rgba(255,255,255,0.02);
  }
  .option:hover { background:rgba(245,158,11,0.07); border-color:rgba(245,158,11,0.25); }
  .option.selected { background:rgba(245,158,11,0.12); border-color:var(--accent); }
  .option input[type=radio] { display:none; }
  .opt-letter {
    min-width:28px; height:28px; border-radius:50%; border:1.5px solid var(--border);
    display:flex; align-items:center; justify-content:center;
    font-size:12px; font-weight:700; color:var(--text2); transition:all 0.15s; flex-shrink:0; margin-top:1px;
  }
  .option.selected .opt-letter { background:var(--accent); border-color:var(--accent); color:#000; }
  .opt-text { font-size:14px; line-height:1.6; color:var(--text2); }
  .option.selected .opt-text { color:var(--text); }

  .likert-card { background:var(--card); border:1px solid var(--border); border-radius:16px; overflow:hidden; margin-bottom:24px; }
  .likert-header {
    display:grid; grid-template-columns:1fr repeat(5,52px);
    background:rgba(255,255,255,0.03); border-bottom:1px solid var(--border);
    padding:12px 20px; font-size:11px; font-weight:600; color:var(--text2);
  }
  .likert-header .score-lbl { text-align:center; font-size:11px; line-height:1.3; }
  .likert-row {
    display:grid; grid-template-columns:1fr repeat(5,52px);
    align-items:center; padding:14px 20px;
    border-bottom:1px solid rgba(255,255,255,0.04); transition:background 0.1s;
  }
  .likert-row:last-child { border-bottom:none; }
  .likert-row:hover { background:rgba(255,255,255,0.02); }
  .q-num { font-size:11px; font-weight:700; color:var(--accent); margin-right:4px; }
  .q-text { font-size:13.5px; line-height:1.5; color:var(--text); padding-right:12px; }
  .q-cell { text-align:center; }
  .q-cell input[type=radio] { display:none; }
  .q-cell label {
    display:inline-flex; align-items:center; justify-content:center;
    width:32px; height:32px; border-radius:50%; border:1.5px solid var(--border);
    cursor:pointer; font-size:12px; font-weight:600; color:var(--text2); transition:all 0.15s;
  }
  .q-cell label:hover { border-color:var(--accent); color:var(--accent); }
  .q-cell input[type=radio]:checked + label { background:var(--accent); border-color:var(--accent); color:#000; font-weight:800; }

  /* NEW badge for new questions */
  .new-badge {
    display:inline-block; font-size:9px; font-weight:700; letter-spacing:1px;
    background:rgba(6,182,212,0.15); color:var(--accent2);
    padding:2px 6px; border-radius:4px; margin-left:6px; vertical-align:middle;
    text-transform:uppercase;
  }

  @media(max-width:600px){
    .likert-header { display:none; }
    .likert-row { display:flex; flex-direction:column; gap:10px; padding:16px; }
    .q-cells-mobile { display:flex; justify-content:space-between; width:100%; }
    .q-cell label { width:36px; height:36px; font-size:13px; }
  }

  .error-msg {
    background:rgba(239,68,68,0.12); border:1px solid rgba(239,68,68,0.3);
    color:#fca5a5; font-size:13px; padding:12px 20px; border-radius:10px;
    margin-bottom:16px; display:none;
  }
  .btn-wrap { text-align:center; padding:30px 0 60px; }
  .btn-primary {
    display:inline-block; background:linear-gradient(135deg,var(--accent),#d97706);
    color:#000; font-family:'Be Vietnam Pro',sans-serif; font-size:15px; font-weight:800;
    letter-spacing:0.5px; padding:16px 48px; border-radius:99px; border:none;
    cursor:pointer; transition:transform 0.15s, box-shadow 0.15s;
    box-shadow:0 4px 24px rgba(245,158,11,0.35);
  }
  .btn-primary:hover { transform:translateY(-2px); box-shadow:0 8px 32px rgba(245,158,11,0.45); }

  .divider { border:none; border-top:1px solid var(--border); margin:40px 0; }

  /* RESULTS */
  #results { display:none; }
  .result-header { text-align:center; padding:60px 0 40px; }
  .result-header h2 {
    font-family:'Playfair Display',serif; font-size:clamp(26px,4vw,38px); margin-bottom:12px;
    background:linear-gradient(135deg,#fff 0%,var(--accent) 100%);
    -webkit-background-clip:text; -webkit-text-fill-color:transparent;
  }
  .result-header p { color:var(--text2); font-size:14px; }

  .chart-wrap { display:flex; justify-content:center; margin:32px 0; }

  .scores-grid { display:grid; grid-template-columns:1fr 1fr; gap:14px; margin-bottom:32px; }
  @media(max-width:500px){ .scores-grid { grid-template-columns:1fr; } }

  .score-card {
    background:var(--card); border:1px solid var(--border);
    border-radius:14px; padding:18px 20px; position:relative; overflow:hidden;
  }
  .score-card::before { content:''; position:absolute; top:0;left:0;right:0; height:3px; }
  .score-card[data-axis="0"]::before{background:var(--r0);}
  .score-card[data-axis="1"]::before{background:var(--r1);}
  .score-card[data-axis="2"]::before{background:var(--r2);}
  .score-card[data-axis="3"]::before{background:var(--r3);}
  .score-card[data-axis="4"]::before{background:var(--r4);}
  .score-card[data-axis="5"]::before{background:var(--r5);}
  .score-card-label { font-size:11px; font-weight:700; letter-spacing:1.5px; text-transform:uppercase; color:var(--text2); margin-bottom:6px; }
  .score-card-name { font-size:15px; font-weight:700; margin-bottom:10px; }
  .score-bar-bg { background:rgba(255,255,255,0.07); border-radius:99px; height:6px; margin-bottom:8px; }
  .score-bar { height:6px; border-radius:99px; transition:width 1s ease; }
  .score-val { font-size:22px; font-weight:800; }
  .score-badge {
    display:inline-block; font-size:10px; font-weight:700; letter-spacing:1px;
    padding:3px 8px; border-radius:99px; text-transform:uppercase; margin-left:8px; vertical-align:middle;
  }
  .badge-strong { background:rgba(16,185,129,0.15); color:var(--green); }
  .badge-mid    { background:rgba(245,158,11,0.15); color:var(--accent); }
  .badge-weak   { background:rgba(239,68,68,0.15); color:var(--red); }

  .insights { margin-bottom:40px; }
  .insight-card { background:var(--card); border:1px solid var(--border); border-radius:14px; padding:22px 24px; margin-bottom:14px; }
  .insight-card.strong { border-left:3px solid var(--green); }
  .insight-card.weak   { border-left:3px solid var(--red); }
  .insight-title { font-size:13px; font-weight:700; margin-bottom:8px; display:flex; align-items:center; gap:8px; flex-wrap:wrap; }
  .insight-text  { font-size:13.5px; line-height:1.7; color:var(--text2); }
  .insight-text + .insight-text { margin-top:10px; }

  .retry-btn {
    display:inline-block; background:transparent; border:1.5px solid var(--border);
    color:var(--text2); font-family:'Be Vietnam Pro',sans-serif; font-size:14px; font-weight:600;
    padding:13px 36px; border-radius:99px; cursor:pointer; transition:all 0.15s; margin-top:12px;
  }
  .retry-btn:hover { border-color:var(--accent); color:var(--accent); }
</style>
</head>
<body>

<div id="quiz">
  <div class="wrap">
    <header>
      <div class="tag">Bài Test Chẩn Đoán</div>
      <h1>Bánh Xe Nguồn Lực Ảnh Hưởng</h1>
      <p>Xác định bạn đang sử dụng tốt những nguồn lực nào và đang bỏ trống những nguồn lực nào trong môi trường công sở — từ đó tối ưu hóa khả năng phối hợp và dẫn dắt <em>không cần quyền hành chính thức</em>.</p>
    </header>

    <div class="progress-label">
      <span>Tiến độ</span>
      <span id="prog-text">0 / 26 câu</span>
    </div>
    <div class="progress-bar-wrap"><div class="progress-bar" id="prog-bar"></div></div>

    <div class="section-title">Phần 1</div>
    <div class="section-heading">5 Tình Huống Công Sở Điển Hình</div>
    <div class="section-desc">Chọn <strong>một</strong> phương án phản ánh đúng nhất cách bạn sẽ xử lý trong thực tế.</div>
    <div id="situations"></div>

    <hr class="divider">

    <div class="section-title">Phần 2</div>
    <div class="section-heading">21 Câu Hỏi Phản Chiếu Hành Vi</div>
    <div class="section-desc">Đánh giá tần suất bạn thực hiện các hành vi sau trong công việc hàng ngày.<br><span style="color:var(--text2);font-size:13px">1 = Không bao giờ &nbsp;→&nbsp; 5 = Luôn luôn</span></div>

    <div class="likert-card">
      <div class="likert-header">
        <div>Hành vi</div>
        <div class="score-lbl">1<br><span style="font-size:9px;font-weight:400">Không<br>bao giờ</span></div>
        <div class="score-lbl">2<br><span style="font-size:9px;font-weight:400">Hiếm<br>khi</span></div>
        <div class="score-lbl">3<br><span style="font-size:9px;font-weight:400">Thỉnh<br>thoảng</span></div>
        <div class="score-lbl">4<br><span style="font-size:9px;font-weight:400">Thường<br>xuyên</span></div>
        <div class="score-lbl">5<br><span style="font-size:9px;font-weight:400">Luôn<br>luôn</span></div>
      </div>
      <div id="likert-rows"></div>
    </div>

    <div class="error-msg" id="error-msg">⚠️ Vui lòng trả lời đầy đủ tất cả câu hỏi trước khi xem kết quả.</div>
    <div class="btn-wrap">
      <button class="btn-primary" onclick="submitQuiz()">Xem Kết Quả →</button>
    </div>
  </div>
</div>

<!-- USER INFO FORM (shown before quiz submit) -->
<div id="user-info-section" style="display:none;">
  <div class="wrap">
    <div style="padding:48px 0 0;">
      <div class="user-info-card">
        <div class="user-info-title">✏️ Thông tin của bạn</div>
        <div class="user-info-desc">Điền họ và tên để cá nhân hóa báo cáo PDF của bạn.</div>
        <div class="form-row" style="grid-template-columns:1fr">
          <div class="form-group">
            <label>HỌ VÀ TÊN *</label>
            <input type="text" id="user-name" placeholder="Nguyễn Văn A" maxlength="60">
          </div>
        </div>
      </div>
      <div id="user-info-error" class="error-msg">⚠️ Vui lòng nhập họ và tên trước khi xem kết quả.</div>
      <div class="btn-wrap" style="padding-top:0">
        <button class="btn-primary" onclick="proceedToResults()">Xem Kết Quả →</button>
      </div>
    </div>
  </div>
</div>

<!-- RESULTS -->
<div id="results">
  <div class="wrap">
    <div class="result-header">
      <div class="tag">Kết Quả Của Bạn</div>
      <h2>Bánh Xe Nguồn Lực Ảnh Hưởng</h2>
      <p id="result-subtitle">Dựa trên 26 câu trả lời của bạn, đây là hình dạng nguồn lực ảnh hưởng tại công sở.</p>
    </div>
    <div class="chart-wrap"><canvas id="radar" width="440" height="440"></canvas></div>
    <div class="scores-grid" id="scores-grid"></div>
    <hr class="divider">
    <div class="insights" id="insights"></div>
    <div class="btn-row">
      <button class="pdf-btn" id="pdf-btn" onclick="exportPDF()">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/><polyline points="7,10 12,15 17,10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
        Xuất Report PDF
      </button>
      <button class="retry-btn" onclick="restart()">← Làm lại bài test</button>
    </div>
  </div>
</div>


<script>
// ═══════════════════════════════════════════
// DATA
// ═══════════════════════════════════════════
const situations = [
  {
    num:'Tình huống 1',
    q:'Bạn cần một file số liệu gấp từ đồng nghiệp phòng ban khác để hoàn thiện báo cáo. Đã giục 2 lần qua tin nhắn nhưng họ vẫn im lặng hoặc khất lần. Bạn không phải sếp của họ. Bạn sẽ:',
    opts:[
      'Gửi email chính thức, CC sếp của họ và sếp của bạn để gây áp lực bằng quy trình công việc.',
      'Tìm đồng nghiệp chơi thân với cả hai để nhờ nhắc khéo giúp.',
      'Nhắn tin cảnh báo rằng nếu file gửi muộn thì tiến độ chung bị ảnh hưởng và bạn sẽ phải báo cáo lên trên.',
      'Đến tận bàn họ, hỏi thăm xem có đang quá tải không và chủ động giúp xử lý phần việc nào đó để họ có thời gian làm file cho bạn.',
      'Hứa rằng nếu họ giúp bạn lần này, bạn sẽ ưu tiên hỗ trợ bất kỳ việc gì họ cần từ phòng bạn.',
      'Chỉ trực tiếp cho họ một mẹo/biểu mẫu có sẵn giúp hoàn thành file đó chỉ trong 5 phút.',
    ]
  },
  {
    num:'Tình huống 2',
    q:'Bạn phát hiện cách làm mới giúp tiết kiệm rất nhiều thời gian làm việc nhóm, nhưng đồng nghiệp đã quen tay với cách cũ và ngại thay đổi. Bạn sẽ:',
    opts:[
      'Đề xuất sếp ban hành quy định bắt buộc áp dụng quy trình mới.',
      'Tự làm video ngắn hoặc tài liệu hướng dẫn chi tiết để chứng minh tính hiệu quả.',
      'Thuyết phục 1–2 người có "tiếng nói" ngầm trong nhóm dùng thử trước để họ lôi kéo những người còn lại.',
      'Nhận phần việc khó nhất trong những ngày đầu, thừa nhận bản thân cũng từng lúng túng, và cam kết hỗ trợ mọi người từng bước.',
      'Đề xuất cả nhóm rằng nếu áp dụng mượt mà và xong việc sớm, bạn sẽ bao cả nhóm trà sữa/cà phê.',
      'Nhắc nhở trong cuộc họp rằng việc không đổi mới đang làm giảm hiệu suất và có thể ảnh hưởng đến KPI cuối tháng.',
    ]
  },
  {
    num:'Tình huống 3',
    q:'Trong cuộc họp phòng, bạn đưa ra đề xuất nhưng ngay lập tức bị đồng nghiệp lâu năm phản đối: "trước giờ không ai làm thế" hoặc "không khả thi". Bạn sẽ:',
    opts:[
      'Đưa ra số liệu cụ thể, bằng chứng thực tế và logic chuyên môn để chứng minh lập luận của mình.',
      'Gặp riêng họ sau cuộc họp để lắng nghe nỗi lo và chia sẻ góc nhìn cầu thị.',
      'Sử dụng uy tín chức danh hoặc sự ủy quyền từ sếp trước đó để khẳng định quyền quyết định.',
      'Khéo léo nhắc đến lợi ích cụ thể mà giải pháp này mang lại cho chính công việc của người đang phản đối.',
      'Quan sát phản ứng mọi người và tìm sự đồng thuận từ các thành viên khác để cùng bảo vệ ý kiến.',
      'Nhấn mạnh nếu không làm theo phương án này mà xảy ra lỗi do cách cũ, người phản đối sẽ tự chịu trách nhiệm trước sếp.',
    ]
  },
  {
    num:'Tình huống 4',
    q:'Sếp bất ngờ giao cho bạn phụ trách tổ chức một sự kiện nội bộ — hoàn toàn không phải chuyên môn của bạn và bạn đang rất bận. Bạn sẽ:',
    opts:[
      'Nhận lời ngay vì lệnh của sếp, sau đó dùng quyền hạn phân chia công việc cho cấp dưới hoặc intern.',
      'Tận dụng mối quen biết với nhân sự ở Hành chính, Marketing, Nhân sự để hỏi xin kinh nghiệm và nhờ hỗ trợ.',
