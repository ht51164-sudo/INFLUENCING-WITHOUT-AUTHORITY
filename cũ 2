let _cachedScores = null;

function submitQuiz(){
  let missing = false;
  for(let i=0;i<5;i++) if(!document.querySelector(`input[name="s${i}"]:checked`)){ missing=true; break; }
  if(!missing) for(let i=0;i<21;i++) if(!document.querySelector(`input[name="q${i}"]:checked`)){ missing=true; break; }
  const errEl = document.getElementById('error-msg');
  if(missing){
    errEl.style.display='block';
    errEl.scrollIntoView({behavior:'smooth',block:'center'});
    return;
  }
  errEl.style.display='none';
  _cachedScores = calcScores();
  // Show user info section
  document.getElementById('quiz').style.display='none';
  document.getElementById('user-info-section').style.display='block';
  window.scrollTo({top:0,behavior:'smooth'});
}

