// ═══════════════════════════════════════════
// PDF EXPORT
// ═══════════════════════════════════════════

async function exportPDF(){
  const btn = document.getElementById('pdf-btn');
  btn.disabled=true;
  btn.innerHTML='<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><polyline points="12,6 12,12 16,14"/></svg> Đang tạo PDF...';

  try {
    const scores = _cachedScores;
    const name = document.getElementById('user-name').value.trim() || 'Người dùng';
    const dateStr = new Date().toLocaleDateString('vi-VN',{day:'2-digit',month:'2-digit',year:'numeric'});
    const axColors = ['#f59e0b','#06b6d4','#8b5cf6','#10b981','#f43f5e','#fb923c'];
    const axNames  = ['Vi Tri','Ep Buoc','Phan Thuong','Chuyen Gia','Uy Tin CN','Mang Luoi'];
    const axFull   = ['Vị Trí','Ép Buộc','Phần Thưởng','Chuyên Gia','Uy Tín Cá Nhân','Mạng Lưới'];

    const { jsPDF } = window.jspdf;
    const doc = new jsPDF({ orientation:'portrait', unit:'mm', format:'a4' });
    const PW=210, PH=297;
    const ML=18, MR=18, MT=18;
    let y = MT;

    // ── helpers ──
    const hex2rgb = hex => {
      const r=parseInt(hex.slice(1,3),16),g=parseInt(hex.slice(3,5),16),b=parseInt(hex.slice(5,7),16);
      return [r,g,b];
    };
    const setFill = hex => { const [r,g,b]=hex2rgb(hex); doc.setFillColor(r,g,b); };
    const setDraw = hex => { const [r,g,b]=hex2rgb(hex); doc.setDrawColor(r,g,b); };
    const setTxt  = hex => { const [r,g,b]=hex2rgb(hex); doc.setTextColor(r,g,b); };

    // ── HEADER BAR ──
    setFill('#0a0f1e'); doc.rect(0,0,PW,28,'F');
    setTxt('#f59e0b'); doc.setFont('helvetica','bold'); doc.setFontSize(14);
    doc.text('BANH XE NGUON LUC ANH HUONG', ML, 12);
    setTxt('#94a3b8'); doc.setFont('helvetica','normal'); doc.setFontSize(8);
    doc.text('Leading Without Authority  |  Bai Test Chan Doan', ML, 19);
    // name + date top right
    setTxt('#e2e8f0'); doc.setFont('helvetica','bold'); doc.setFontSize(10);
    doc.text(name, PW-MR, 12, {align:'right'});
    setTxt('#94a3b8'); doc.setFont('helvetica','normal'); doc.setFontSize(8);
    doc.text('Ngay lam: ' + dateStr, PW-MR, 19, {align:'right'});
    y = 36;

    // ── RADAR CHART (drawn with doc lines/curves) ──
    const cx=62, cy=y+52, R=46, N=6, maxV=10;
    const ang = i => (-Math.PI/2)+(i/N)*2*Math.PI;

    // bg circle
    setFill('#f8fafc'); setDraw('#e2e8f0');
    doc.setLineWidth(0.1);
    doc.circle(cx,cy,R+4,'F');

    // rings
    for(let ring=1;ring<=5;ring++){
      const r=R*(ring/5);
      doc.setLineWidth(0.2); setDraw('#e2e8f0');
      const pts=[];
      for(let i=0;i<=N;i++){
        const a=ang(i%N);
        pts.push({x:cx+r*Math.cos(a), y:cy+r*Math.sin(a)});
      }
      for(let i=0;i<pts.length-1;i++){
        doc.line(pts[i].x,pts[i].y,pts[i+1].x,pts[i+1].y);
      }
      // ring label
      setTxt('#94a3b8'); doc.setFontSize(5);
      doc.text(String(ring*2), cx+1, cy-r+1.5);
    }
    // axis lines
    doc.setLineWidth(0.2); setDraw('#cbd5e1');
    for(let i=0;i<N;i++){
      doc.line(cx,cy, cx+R*Math.cos(ang(i)), cy+R*Math.sin(ang(i)));
    }
    // data polygon fill
    const dpts=scores.map((s,i)=>{
      const r=R*(s/maxV);
      return {x:cx+r*Math.cos(ang(i)), y:cy+r*Math.sin(ang(i))};
    });
    // draw filled polygon
    doc.setLineWidth(0.5);
    // fill with low-opacity yellow — approximate with light fill
    setFill('#fef3c7'); setDraw('#f59e0b');
    doc.lines(
      dpts.slice(1).map((p,i)=>[p.x-dpts[i].x, p.y-dpts[i].y]),
      dpts[0].x, dpts[0].y, [1,1], 'FD', true
    );
    // dots
    scores.forEach((s,i)=>{
      const r=R*(s/maxV);
      const px=cx+r*Math.cos(ang(i)), py=cy+r*Math.sin(ang(i));
      const [r2,g2,b2]=hex2rgb(axColors[i]);
      doc.setFillColor(r2,g2,b2);
      doc.circle(px,py,1.8,'F');
    });
    // axis labels
    scores.forEach((s,i)=>{
      const off=R+8;
      const px=cx+off*Math.cos(ang(i)), py=cy+off*Math.sin(ang(i));
      const [r2,g2,b2]=hex2rgb(axColors[i]);
      doc.setTextColor(r2,g2,b2);
      doc.setFont('helvetica','bold'); doc.setFontSize(6.5);
      const words=axNames[i].split(' ');
      words.forEach((w,wi)=>doc.text(w, px, py+(wi-(words.length-1)/2)*4, {align:'center'}));
    });

    // ── SCORE BARS (right of radar) ──
    const bx=115, bw=PW-MR-bx, bh=5;
    let by=y+8;
    setTxt('#0f172a'); doc.setFont('helvetica','bold'); doc.setFontSize(9);
    doc.text('DIEM SO 6 TRUC', bx, by); by+=8;

    scores.forEach((s,i)=>{
      const pct=s/10;
      const [r2,g2,b2]=hex2rgb(axColors[i]);
      // axis name
      doc.setTextColor(r2,g2,b2); doc.setFont('helvetica','bold'); doc.setFontSize(7.5);
      doc.text(axFull[i], bx, by);
      // score value
      setTxt('#0f172a'); doc.setFont('helvetica','bold'); doc.setFontSize(9);
      doc.text(s.toFixed(1)+'/10', PW-MR, by, {align:'right'});
      by+=4;
      // bar bg
      doc.setFillColor(225,232,240); doc.rect(bx, by, bw, bh, 'F');
      // bar fill
      doc.setFillColor(r2,g2,b2);
      if(pct>0) doc.rect(bx, by, bw*pct, bh, 'F');
      // badge
      const badge = s>=7.5?'The manh':s>=5?'Phat trien':'Can kich hoat';
      const badgeBg = s>=7.5?'#dcfce7':s>=5?'#fef9c3':'#fee2e2';
      const badgeTxt= s>=7.5?'#166534':s>=5?'#854d0e':'#991b1b';
      setFill(badgeBg); setDraw(badgeBg);
      doc.rect(bx+bw*pct+2, by-0.5, 18, bh+1, 'FD');
      const [rt,gt,bt]=hex2rgb(badgeTxt);
      doc.setTextColor(rt,gt,bt); doc.setFont('helvetica','bold'); doc.setFontSize(5.5);
      doc.text(badge, bx+bw*pct+11, by+bh/2+0.5, {align:'center'});
      by+=10;
    });

    y = cy + R + 12;

    // ── DIVIDER ──
    setDraw('#e2e8f0'); doc.setLineWidth(0.3);
    doc.line(ML, y, PW-MR, y); y+=8;

    // ── INSIGHTS ──
    const strong=scores.map((s,i)=>({s,i})).filter(x=>x.s>=7.5);
    const mid   =scores.map((s,i)=>({s,i})).filter(x=>x.s>=5&&x.s<7.5);
    const weak  =scores.map((s,i)=>({s,i})).filter(x=>x.s<5);

    const insightStrongArr=[
      'Ban biet tan dung cau truc to chuc de gay anh huong. Day la don bay manh — hay dung co chon loc.',
      'Ban san sang dat ra ky luat va giu vung ranh gioi. Hieu qua ngan han — hay can bang voi uy tin ca nhan.',
      'Ban gioi tao ra cac trao doi tich cuc. Day la chat keo giu mang luoi cong tac.',
      'Chuyen mon la nguon luc ben vung nhat — no thuoc ve ban, khong ai lay di duoc.',
      'Nguoi ta theo ban vi ban la ai, khong phai vi chuc danh. Day la nguon luc hiem va quy nhat.',
      'Ban biet cach xay dung va kich hoat cac moi quan he — day la sieu nang luc thuc su.',
    ];
    const insightWeakArr=[
      'It dua vao chuc vu. Hay hoc cach van dung quy trinh chinh thuc khi can thiet.',
      'It su dung ap luc. Doi khi dat ranh gioi ro rang la can thiet de bao ve chat luong cong viec.',
      'Chua chu trong tao doi trao doi tich cuc. Thu nhung cu chi nho — loi cam on, ca phe — de cung co hop tac.',
      'Chuyen mon chua duoc the hien du manh. Hay chia se kien thuc va ho tro dong nghiep giai quyet ca kho.',
      'Uy tin ca nhan dang la khoang trong lon. Hay dau tu vao su dong cam va tinh chan thanh.',
      'Mang luoi mong. Hay chu dong "Serve & Share" — giup nguoi khac truoc khi can nho.',
    ];

    const drawInsightBlock = (label, text, borderColor, bgColor) => {
      const blockW=PW-ML-MR;
      const lines1=doc.splitTextToSize('  '+label, blockW-8);
      const lines2=doc.splitTextToSize(text, blockW-8);
      const blockH=(lines1.length+lines2.length)*4+8;
      if(y+blockH>PH-14){ doc.addPage(); y=MT; }
      // bg
      setFill(bgColor); setDraw(bgColor);
      doc.rect(ML, y, blockW, blockH, 'F');
      // left border
      const [rb,gb,bb]=hex2rgb(borderColor);
      doc.setFillColor(rb,gb,bb);
      doc.rect(ML, y, 2.5, blockH, 'F');
      // label
      const [rl,gl,bl]=hex2rgb(borderColor);
      doc.setTextColor(rl,gl,bl); doc.setFont('helvetica','bold'); doc.setFontSize(7.5);
      doc.text(lines1, ML+5, y+5);
      // text
      setTxt('#475569'); doc.setFont('helvetica','normal'); doc.setFontSize(7);
      doc.text(lines2, ML+5, y+5+lines1.length*4+1);
      y+=blockH+4;
    };

    // Section heading
    setTxt('#64748b'); doc.setFont('helvetica','bold'); doc.setFontSize(9);
    doc.text('PHAN TICH & KHUYEN NGHI', ML, y); y+=8;

    if(strong.length){
      const txt=strong.map(x=>`${axFull[x.i]}: ${insightStrongArr[x.i]}`).join('  |  ');
      drawInsightBlock('💪 THE MANH (>= 7.5 diem) — '+strong.map(x=>axFull[x.i]).join(', '), txt, '#10b981','#f0fdf4');
    }
    if(mid.length){
      drawInsightBlock('⚡ DANG PHAT TRIEN (5 - 7.5 diem) — '+mid.map(x=>axFull[x.i]).join(', '),
        'Ban dang tren da tot. Chi can duy tri va tinh chinh them mot chut la co the nang len muc the manh.',
        '#f59e0b','#fffbeb');
    }
    if(weak.length){
      const txt=weak.map(x=>`${axFull[x.i]}: ${insightWeakArr[x.i]}`).join('  |  ');
      drawInsightBlock('🎯 CAN KICH HOAT (< 5 diem) — '+weak.map(x=>axFull[x.i]).join(', '), txt, '#ef4444','#fef2f2');
    }
    drawInsightBlock('📌 TRIET LY LEADING WITHOUT AUTHORITY',
      'Anh huong thuc su khong den tu chuc danh — ma den tu su ket hop hoa nhip cua ca 6 nguon luc. Hay bat dau tu viec Serve & Share nhieu hon moi ngay.',
      '#8b5cf6','#f5f3ff');

    // ── FOOTER ──
    if(y>PH-14){ doc.addPage(); y=MT; }
    y=PH-10;
    setDraw('#e2e8f0'); doc.setLineWidth(0.2);
    doc.line(ML,y-4,PW-MR,y-4);
    setTxt('#94a3b8'); doc.setFont('helvetica','normal'); doc.setFontSize(7);
    doc.text('Banh Xe Nguon Luc Anh Huong  |  Leading Without Authority', ML, y);
    doc.text('Ket qua mang tinh tham khao dua tren tu danh gia', PW-MR, y, {align:'right'});

    // ── SAVE ──
    const fileName='BanhXeNguonLuc_'+name.replace(/\s+/g,'_')+'_'+dateStr.replace(/\//g,'-')+'.pdf';
    doc.save(fileName);

  } catch(e){
    alert('Co loi khi tao PDF. Vui long thu lai.\n'+e.message);
    console.error(e);
  }

  btn.disabled=false;
  btn.innerHTML='<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/><polyline points="7,10 12,15 17,10"/><line x1="12" y1="15" x2="12" y2="3"/></svg> Xuất Report PDF';
}</script>
