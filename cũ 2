  if(strong.length){
    const card=document.createElement('div');
    card.className='insight-card strong';
    const names=strong.map(x=>`<span style="color:${axes[x.i].color};font-weight:700">${axes[x.i].name}</span>`).join(', ');
    card.innerHTML=`<div class="insight-title">💪 Thế Mạnh (≥ 7.5đ) — ${names}</div>
      <div class="insight-text">${strong.map(x=>`<strong style="color:${axes[x.i].color}">${axes[x.i].name}:</strong> ${insightStrong[x.i]}`).join('<br><br>')}</div>`;
    container.appendChild(card);
  }

  if(mid.length){
    const card=document.createElement('div');
    card.className='insight-card';
    card.style.borderLeft='3px solid var(--accent)';
    const names=mid.map(x=>`<span style="color:${axes[x.i].color};font-weight:700">${axes[x.i].name}</span>`).join(', ');
    card.innerHTML=`<div class="insight-title">⚡ Đang Phát Triển (5 – 7.5đ) — ${names}</div>
      <div class="insight-text">Bạn đang trên đà tốt với các nguồn lực này. Chỉ cần duy trì và tinh chỉnh thêm một chút là có thể nâng lên mức thế mạnh. Hãy quan sát xem mình đang thiếu ở hành vi nào cụ thể nhất.</div>`;
    container.appendChild(card);
  }

  if(weak.length){
    const card=document.createElement('div');
    card.className='insight-card weak';
    const names=weak.map(x=>`<span style="color:${axes[x.i].color};font-weight:700">${axes[x.i].name}</span>`).join(', ');
    card.innerHTML=`<div class="insight-title">🎯 Cần Kích Hoạt (&lt; 5đ) — ${names}</div>
      <div class="insight-text">${weak.map(x=>`<strong style="color:${axes[x.i].color}">${axes[x.i].name}:</strong> ${insightWeak[x.i]}`).join('<br><br>')}</div>`;
    container.appendChild(card);
  }

  // LWA Philosophy note
  const note=document.createElement('div');
  note.className='insight-card';
  note.style.cssText='border-left:3px solid var(--accent3);margin-top:8px;';
  note.innerHTML=`<div class="insight-title" style="color:var(--accent3)">📌 Triết Lý Leading Without Authority</div>
    <div class="insight-text">Trong môi trường công sở hiện đại, ảnh hưởng thực sự không đến từ chức danh — mà đến từ sự kết hợp hài hòa của cả 6 nguồn lực.<br><br>
    Nếu <strong style="color:#f43f5e">Uy Tín Cá Nhân</strong> hoặc <strong style="color:#fb923c">Mạng Lưới</strong> của bạn quá thấp, bạn sẽ gặp rất nhiều lực cản khi phối hợp liên phòng ban — dù bạn có chuyên môn giỏi đến đâu.<br><br>
    Hãy bắt đầu từ việc <em><strong>Serve & Share</strong></em> nhiều hơn mỗi ngày: chủ động giúp trước, chia sẻ kiến thức trước, kết nối trước — và nguồn lực ảnh hưởng sẽ tự nhiên tích lũy theo thời gian.</div>`;
  container.appendChild(note);
}

function restart(){
  document.querySelectorAll('input[type=radio]').forEach(inp=>inp.checked=false);
  document.querySelectorAll('.option').forEach(o=>o.classList.remove('selected'));
  document.getElementById('quiz').style.display='block';
  document.getElementById('results').style.display='none';
  document.getElementById('user-info-section').style.display='none';
  document.getElementById('user-name').value='';
  _cachedScores=null;
  updateProgress();
  window.scrollTo({top:0,behavior:'smooth'});
}

